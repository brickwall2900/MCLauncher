<?xml version="1.0" encoding="UTF-8"?>
<Configuration packages="omw.loggingservice">
    <Appenders>
        <Console name="STDOUT" target="SYSTEM_OUT">
            <!-- <PatternLayout pattern="%d %-5p %-20c{2} - %-15m%n"/> -->
            <PatternLayout pattern="[%d{hh:mm:ss.SSS a} | %level] %c{1} [%t]: %m %n"/>
        </Console>
        <RollingFile name="FILE_LOG" >
<!--            <fileName>${sys:user.home}/TestEngine/logs/latest.txt</fileName>-->
<!--            <filePattern>${sys:user.home}/TestEngine/logs/log_%d{yyyy-MM-dd HH-mm-ss}.txt</filePattern>-->
            <!-- <PatternLayout pattern="%d %-5p %-20c{2} - %-15m%n"/> -->
            <fileName>./logs/latest.log</fileName>
            <filePattern>./logs/log_%d{yyyy-MM-dd HH-mm-ss}.log</filePattern>
            <PatternLayout pattern="[%d{hh:mm:ss.SSS a}] %level | %c{1} (%t): %m %n"/>
            <Policies>
                <OnStartupTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max = "10"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Root level="debug">
            <AppenderRef ref="STDOUT"/>
            <AppenderRef ref="FILE_LOG"/>
        </Root>
    </Loggers>
</Configuration>
